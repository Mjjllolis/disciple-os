# ---------------------------------------------------------------- Firebase ---
# Client SDK (browser). Firebase Console > Project settings > General.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Admin SDK (server). REQUIRED for local development — all church, survey,
# sermon and tour data is read and written server-side.
# Firebase Console > Project settings > Service accounts > "Generate new
# private key", then paste the JSON on a single line:
FIREBASE_SERVICE_ACCOUNT=
# Or supply the three fields individually instead:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
#
# On Firebase App Hosting none of the above is needed — Application Default
# Credentials are used automatically. Only FIREBASE_PROJECT_ID is required.

# ---------------------------------------------------------------- NextAuth ---
# REQUIRED. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------ Claude ---
# REQUIRED for AI features: survey analysis, sermons, the categorizer.
# console.anthropic.com > API keys. (ANTHROPIC_API_KEY also works.)
CLAUDE_API_KEY=
# Optional model override; defaults to claude-opus-5-5.
# ANTHROPIC_MODEL=claude-opus-5-5

# ------------------------------------------------------------------ OpenAI ---
# Only used by Image Studio (image generation).
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1

# ------------------------------------------------------------------- Email ---
# Optional. Without it, invitations and booking confirmations are logged to the
# server console instead of sent, and the UI offers a copyable invite link.
RESEND_API_KEY=
EMAIL_FROM="DiscipleShip International <noreply@example.com>"

# ------------------------------------------------------------------ Stripe ---
# Optional. Without these, the buy buttons are disabled and an admin tops
# churches up from /admin instead.
# Dashboard > Developers > API keys (use sk_test_... until you go live).
STRIPE_SECRET_KEY=
# Dashboard > Developers > Webhooks > your endpoint > Signing secret.
# Point the endpoint at https://your-domain/api/billing/webhook and subscribe to
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed, and charge.refunded.
# Locally: npx stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Optional; defaults to usd.
# STRIPE_CURRENCY=usd

# ------------------------------------------------------------------- Admin ---
# Comma-separated emails that always get platform super-admin access.
SUPER_ADMIN_EMAILS=

# Credits a newly registered church starts with (default 250).
WELCOME_CREDITS=250
