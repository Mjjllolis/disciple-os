rules_version = '2';

// All application data is read and written by the Next.js server through the
// Firebase Admin SDK, which bypasses these rules. The browser only ever talks
// to Firebase for password sign-in, never to Firestore directly.
//
// So the correct posture is: deny every direct client request. If a rule here
// ever needs to open up, that means data access moved to the browser and the
// multi-tenant checks in lib/session.ts are being bypassed — treat that as a bug.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
