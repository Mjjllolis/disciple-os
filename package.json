{
  "name": "discipleship-international",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "mkdir -p .emulator-data && NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-discipleos FIREBASE_PROJECT_ID=demo-discipleos SUPER_ADMIN_EMAILS=admin@example.com WELCOME_CREDITS=5000 npx -y firebase-tools emulators:exec --project demo-discipleos --ui --import=.emulator-data --export-on-exit=.emulator-data 'npm run seed:fbc-test && next dev'",
    "dev:cloud": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed:fbc-test": "npx -y tsx --env-file=.env.local scripts/seed-fbc-test.ts",
    "test:local": "bash scripts/smoke-local.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.1.1",
    "@mantine/core": "^7.16.3",
    "@mantine/form": "^7.16.3",
    "@mantine/hooks": "^7.16.3",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.5",
    "@mui/material-nextjs": "^6.5.0",
    "@tabler/icons-react": "^3.30.0",
    "chart.js": "^4.4.8",
    "docx": "^9.2.0",
    "file-saver": "^2.0.5",
    "firebase": "^11.3.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^12.4.5",
    "next": "15.1.6",
    "next-auth": "^4.24.11",
    "openai": "^4.104.0",
    "pptxgenjs": "^3.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.1",
    "stripe": "^22.5.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
