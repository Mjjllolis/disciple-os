rules_version = '2';

// Generated images are written by the server (Admin SDK, which bypasses these
// rules) and read through Firebase download-token URLs. Browsers never need
// direct access, so nothing is granted here.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
